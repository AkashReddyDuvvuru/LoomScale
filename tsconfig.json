{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@vas-kaizen/core/*": ["packages/core/src/*"],
      "@vas-kaizen/server/*": ["packages/server/src/*"],
      "@vas-kaizen/web/*": ["packages/web/src/*"],
      "@vas-kaizen/mobile/*": ["packages/mobile/src/*"],
      "@vas-kaizen/shared/*": ["packages/shared/src/*"]
    }
  },
  "include": ["packages/*/src"],
  "references": [
    { "path": "./packages/core" },
    { "path": "./packages/server" },
    { "path": "./packages/web" },
    { "path": "./packages/mobile" },
    { "path": "./packages/shared" }
  ]
}
